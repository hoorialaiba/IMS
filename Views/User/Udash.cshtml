@{
    Layout = null;
    ViewData["Title"] = "User Dashboard";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - HMH Mart</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.0/font/bootstrap-icons.css">
    <style>
        :root {
            --hmh-teal: #008080;
            --hmh-light: #f8f9fa;
            --hmh-danger: #dc3545;
            --hmh-icon-green: #28a745;
        }

        body {
            font-family: 'Segoe UI', system-ui, sans-serif;
            background-color: #f5f5f5;
            min-height: 100vh;
            overflow-x: hidden;
        }

        .sidebar {
            height: 100vh;
            background: white;
            border-right: 1px solid #eee;
            position: fixed;
            width: 280px;
            z-index: 1000;
            transition: transform 0.3s ease-in-out;
        }

        .main-content {
            margin-left: 280px;
            padding: 2rem;
            background-color: var(--hmh-light);
            width: calc(100% - 280px);
            box-sizing: border-box;
            transition: margin 0.3s ease-in-out;
        }

        .card-hover {
            background: white;
            border: none;
            border-radius: 16px;
            box-shadow: 0 4px 24px rgba(0, 128, 128, 0.05);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

            .card-hover:hover {
                transform: translateY(-3px);
                box-shadow: 0 6px 20px rgba(0, 128, 128, 0.1);
            }

        .nav-link {
            padding: 0.75rem 1.5rem;
            color: #666;
            border-radius: 8px;
            transition: all 0.2s;
        }

        .active-menu {
            background-color: rgba(0, 128, 128, 0.1) !important;
            color: var(--hmh-teal) !important;
            border-left: 3px solid var(--hmh-teal) !important;
        }

        .hmh-text-teal {
            color: var(--hmh-teal);
        }
        .btn-hmh {
            background-color: var(--hmh-teal);
            color: white;
            padding: 10px 25px;
            border-radius: 30px;
            font-weight: 500;
            transition: all 0.3s;
        }

            .btn-hmh:hover {
                background-color: #006666;
                color: white;
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
            }

        .hmh-icon-green {
            color: var(--hmh-icon-green) !important;
        }

        .checkout-btn {
            padding: 8px 20px;
            font-size: 0.9rem;
        }

        .delete-btn {
            padding: 5px;
            border-radius: 50%;
            width: 28px;
            height: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        @@media (max-width: 992px) {
            .sidebar

        {
            transform: translateX(-100%);
            width: 280px;
        }

        .sidebar.mobile-visible {
            transform: translateX(0);
        }

        .main-content {
            margin-left: 0;
            width: 100%;
            padding: 1.5rem;
        }

        }

        @@media (max-width: 768px) {
            .navbar-brand

        {
            font-size: 1.1rem;
        }

        }

        @@media (max-width: 576px) {
            .table td, .table th

        {
            white-space: nowrap;
            min-width: 120px;
        }

        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <div class="sidebar p-3">
                <div class="mb-4">
                    <h4 class="fw-semibold hmh-text-teal">
                        <i class="bi bi-basket-fill me-2"></i>HMH Mart
                    </h4>
                </div>
                <nav class="nav flex-column">
                    <a class="nav-link active-menu" href="#products">
                        <i class="bi bi-box-seam me-2"></i>Dashboard
                    </a>
                    <a class="nav-link" href="./Cart">
                        <i class="bi bi-cart3 me-2"></i>Shopping Cart
                    </a>
                    <a class="nav-link" href="../Home/Catalogue">
                        <i class="bi bi-search me-2"></i>Browse Products
                    </a>
                    <a class="nav-link" href="/User/Orders">
                        <i class="bi bi-list-check me-2"></i>Orders
                    </a>
                </nav>
            </div>

            <div class="main-content">
                <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm mb-4">
                    <div class="container-fluid">
                        <a class="navbar-brand fw-bold hmh-text-teal">
                            <i class="bi bi-basket-fill me-2"></i>HMH Mart
                        </a>
                        <div class="d-flex align-items-center ms-auto">
                            <div class="dropdown">
                                <a href="#" class="d-block link-dark text-decoration-none dropdown-toggle" id="dropdownUser" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle me-1 hmh-text-teal"></i> User Account
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" href="#">Profile</a></li>
                                    <li><a class="dropdown-item" href="#">Settings</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="#">Sign out</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </nav>

                <div class="card-hover p-4 mb-4">
                    <h5 class="fw-semibold hmh-text-teal mb-4"><i class="bi bi-cart3 me-2"></i>Shopping Cart</h5>
                    <div class="cart-items">
                        <div class="d-flex justify-content-between align-items-center mb-3 p-2">
                            <div>
                                <div class="fw-semibold">Premium Olive Oil</div>
                                <small class="text-muted">$8.99 × 2</small>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="hmh-text-teal fw-semibold">$17.98</span>
                                <button class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="mt-4 pt-3 border-top">
                        <div class="d-flex justify-content-between fw-semibold mb-3">
                            <span>Total:</span>
                            <span class="hmh-text-teal">$42.50</span>
                        </div>
                        <button class="btn btn-hmh checkout-btn w-100">
                            <i class="bi bi-credit-card me-2"></i>Checkout Now
                        </button>
                    </div>
                </div>

                <div class="card-hover p-4 mb-4">
                    <h5 class="fw-semibold hmh-text-teal mb-4"><i class="bi bi-lightning-charge me-2"></i>Active Orders</h5>
                    <div class="order-list">
                        <div class="d-flex justify-content-between align-items-center p-3 mb-3">
                            <div>
                                <div class="fw-semibold">#ORD-1052</div>
                                <small class="text-muted">3 items · Est. Delivery: 2023-06-20</small>
                            </div>
                            <div class="d-flex align-items-center gap-3">
                                <span class="badge bg-warning bg-opacity-10 text-warning">Processing</span>
                                <button class="btn btn-hmh btn-sm">
                                    <i class="bi bi-eye"></i> Details
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-hover p-4">
                    <h5 class="fw-semibold hmh-text-teal mb-4"><i class="bi bi-search me-2"></i>Featured Products</h5>
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="card-hover p-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fw-semibold mb-1">Organic Honey</div>
                                        <small class="text-muted">Food · 500g</small>
                                        <div class="mt-2 hmh-text-teal fw-semibold">$6.99</div>
                                    </div>
                                    <button class="btn btn-hmh btn-sm">
                                        <i class="bi bi-cart-plus"></i> Add
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const sidebar = document.querySelector('.sidebar');
            const menuToggle = document.createElement('button');
            menuToggle.className = 'btn btn-hmh d-lg-none position-fixed';
            menuToggle.style.bottom = '20px';
            menuToggle.style.right = '20px';
            menuToggle.style.zIndex = '1000';
            menuToggle.innerHTML = '<i class="bi bi-list"></i> Menu';

            menuToggle.addEventListener('click', () => {
                sidebar.classList.toggle('mobile-visible');
            });

            document.body.appendChild(menuToggle);
            document.querySelectorAll('.nav-link').forEach(link => {
                if(link.href === window.location.href) {
                    link.classList.add('active-menu');
                }
            });
        });
    </script>
</body>
</html>